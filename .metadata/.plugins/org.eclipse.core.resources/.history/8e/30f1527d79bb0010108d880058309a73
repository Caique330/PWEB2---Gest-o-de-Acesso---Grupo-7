                            <c:if test="${user.id != 1}">
                                <a href="${pageContext.request.contextPath}/usuarios?action=delete&id=${user.id}" 
                                   class="btn btn-danger" 
                                   onclick="return confirm('Tem certeza que deseja excluir ${user.nomeCompleto}?');">
                                   Excluir
                                </a>
                            </c:if>
                        </td>
                    </tr>
                </c:forEach>
            </tbody>
        </table>

    </div>

</body>
</html>