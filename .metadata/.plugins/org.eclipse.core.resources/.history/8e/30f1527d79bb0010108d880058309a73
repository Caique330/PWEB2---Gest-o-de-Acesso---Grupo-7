<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Gestão de Usuários - TechMaster</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;700&display=swap');
        body { font-family: 'Roboto', sans-serif; background-color: #f4f7f6; margin: 0; padding: 0; }
        .header { background-color: #ffffff; padding: 1rem 2rem; box-shadow: 0 2px 5px rgba(0,0,0,0.1); display: flex; justify-content: space-between; align-items: center; }
        .header h1 { color: #007bff; margin: 0; font-weight: 700; }
        .header-nav a { text-decoration: none; color: #555; font-weight: 500; margin-left: 1rem; }
        .header-nav a.logout { color: #dc3545; }
        .container { padding: 2rem; max-width: 1200px; margin: 2rem auto; background-color: #fff; border-radius: 8px; box-shadow: 0 5px 15px rgba(0,0,0,0.05); }
        .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
        .page-header h2 { margin: 0; }
        .btn { text-decoration: none; padding: 0.6rem 1.2rem; border-radius: 5px; font-weight: 500; transition: background-color 0.3s ease; }
        .btn-primary { background-color: #007bff; color: white; }
        .btn-primary:hover { background-color: #0056b3; }
        .btn-secondary { background-color: #6c757d; color: white; }
        .btn-danger { background-color: #dc3545; color: white; }
        .btn-info { background-color: #17a2b8; color: white; }
        
        table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
        th, td { padding: 0.9rem; text-align: left; border-bottom: 1px solid #ddd; }
        th { background-color: #f8f9fa; }
        .actions a { margin-right: 0.5rem; }
    </style>
</head>
<body>

    <div class="header">
        <h1>TechMaster G7</h1>
        <div class="header-nav">
        <a href="${pageContext.request.contextPath}/recursos">Recursos</a>
            <a href="${pageContext.request.contextPath}/dashboard">Dashboard</a>
            <a href="${pageContext.request.contextPath}/logout" class="logout">Sair</a>
        </div>
    </div>

    <div class="container">
        <div class="page-header">
            <h2>Gestão de Usuários</h2>
            <a href="${pageContext.request.contextPath}/usuarios?action=new" class="btn btn-primary">Novo Usuário</a>
        </div>

        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nome Completo</th>
                    <th>Login</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                <c:forEach var="user" items="${listaUsuarios}">
                    <tr>
                        <td>${user.id}</td>
                        <td>${user.nomeCompleto}</td>
                        <td>${user.login}</td>
                        <td>${user.email}</td>
                        <td>${user.status}</td>
                        <td class="actions">
                        ...
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nome Completo</th>
                    <th>Login</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th>Ações</th> </tr>
            </thead>
            <tbody>
                <c:forEach var="user" items="${listaUsuarios}">
                    <tr>
                        
                        <td class="actions">
                            <a href="${pageContext.request.contextPath}/usuarios?action=edit&id=${user.id}" class="btn btn-secondary">Editar</a>
                            
                            <a href="${pageContext.request.contextPath}/associacao?userId=${user.id}" 
                               class="btn btn-info">
                               Perfis
                            </a>
                            
                            <c:if test="${user.id != 1}">
                                <a href="${pageContext.request.contextPath}/usuarios?action=delete&id=${user.id}" ...>
                                   Excluir
                                </a>
                            </c:if>
                        </td>
                    </tr>
                </c:forEach>
            </tbody>
        </table>
