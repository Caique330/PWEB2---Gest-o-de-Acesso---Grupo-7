package br.com.techmaster.g7.filter;

import java.io.IOException;
import javax.servlet.Filter;
import javax.servlet.FilterChain;
import javax.servlet.FilterConfig;
import javax.servlet.ServletException;
import javax.servlet.ServletRequest;
import javax.servlet.ServletResponse;
import javax.servlet.annotation.WebFilter;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;
import javax.servlet.http.HttpSession;
import br.com.techmaster.g7.dao.LogDAO;
import br.com.techmaster.g7.model.LogTentativaFalha;
import br.com.techmaster.g7.util.RequestUtil;

/**
 * Este filtro protege todas as páginas, exceto o login.
 */
// Mapeamento: "/*" pega TUDO.
@WebFilter("/*") 
public class AuthFilter implements Filter {

    public void doFilter(ServletRequest request, ServletResponse response, FilterChain chain) 
            throws IOException, ServletException {
        
        HttpServletRequest httpRequest = (HttpServletRequest) request;
        HttpServletResponse httpResponse = (HttpServletResponse) response;

        // URL que o usuário está tentando acessar
        String uri = httpRequest.getRequestURI();
        
        // Pega a sessão (sem criar uma nova se não existir)
        HttpSession session = httpRequest.getSession(false);

        // Verifica se o usuário está logado
        boolean isLoggedIn = (session != null && session.getAttribute("usuarioLogado") != null);

        // Define URIs que SÃO permitidas (públicas)
        boolean isLoginURI = uri.endsWith("/login");
        boolean isLoginPage = uri.endsWith("/login.jsp");
        // (Adicionar aqui URIs de recursos estáticos, ex: /css, /js, se necessário)

        if (isLoggedIn || isLoginURI || isLoginPage) {
            // Se (Está logado) OU (Está tentando acessar o login), deixa passar.
            chain.doFilter(request, response);
        } else {
            // Não está logado E está tentando acessar uma área protegida.
            
            // TODO: Registrar a tentativa de acesso não autorizado (T_LOG_TENTATIVA_FALHA)
            
            // Redireciona para o login
            httpResponse.sendRedirect(httpRequest.getContextPath() + "/login");
        }
    }

    public void init(FilterConfig fConfig) throws ServletException {}
    public void destroy() {}
}