package br.com.techmaster.g7.model;

// Representa a entidade T_RECURSO
public class Recurso {

    private int id;
    private String nomeRecurso;
    private String tipoRecurso; // (SISTEMA, SERVICO, RECURSO)

    // Construtores
    public Recurso() {}
    
    public Recurso(int id, String nomeRecurso, String tipoRecurso) {
        this.id = id;
        this.nomeRecurso = nomeRecurso;
        this.tipoRecurso = tipoRecurso;
    }

    // Getters e Setters
    public int getId() {
        return id;
    }
    public void setId(int id) {
        this.id = id;
    }
    public String getNomeRecurso() {
        return nomeRecurso;
    }
    public void setNomeRecurso(String nomeRecurso) {
        this.nomeRecurso = nomeRecurso;
    }
    public String getTipoRecurso() {
        return tipoRecurso;
    }
    public void setTipoRecurso(String tipoRecurso) {
        this.tipoRecurso = tipoRecurso;
    }
}